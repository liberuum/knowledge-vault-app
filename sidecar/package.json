{
  "name": "@knowledge-vault-app/sidecar",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/*.mjs dist/",
    "dev": "bun run build && KV_STDIN_STOP=1 KV_DATA_DIR=../.dev-data KV_PORT=4201 KV_CONTROL_PORT=4202 KV_CONTROL_TOKEN=dev-token KV_HOST_ORIGIN=http://127.0.0.1:4200 node dist/main.js",
    "tsc": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@powerhousedao/knowledge-note": "1.0.54-dev.29",
    "@powerhousedao/switchboard": "6.2.3-dev.44",
    "@powerhousedao/workflow": "6.2.3-dev.44",
    "@renown/sdk": "6.2.3-dev.44",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "typescript": "^5.9.3",
    "vitest": "4.1.1"
  }
}
