{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Knowledge Vault",
  "version": "0.2.0",
  "identifier": "io.github.liberuum.knowledge-vault-app",
  "build": {
    "devUrl": "http://127.0.0.1:4200",
    "frontendDist": "../host/dist",
    "beforeBuildCommand": "node scripts/check-bundle-inputs.mjs"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Your Powerhouse Knowledge Vault, on your own computer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/kv-node"
    ],
    "resources": {
      "../.stage/sidecar/": "sidecar/"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "13.5",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
