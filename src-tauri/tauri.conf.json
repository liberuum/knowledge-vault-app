{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Knowledge Vault",
  "version": "0.2.5",
  "identifier": "io.github.liberuum.knowledge-vault-app",
  "build": {
    "devUrl": "http://127.0.0.1:4200",
    "frontendDist": "../host/dist",
    "beforeBuildCommand": "node scripts/check-bundle-inputs.mjs"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Your Powerhouse Knowledge Vault, on your own computer",
    "longDescription": "Turn what you read into a knowledge base you can search, explore and talk to, privately, on your own computer. Knowledge Vault breaks each document into atomic notes, links them to the notes they build on, support or contradict, and gathers them into maps by theme.",
    "copyright": "Copyright © 2026 liberuum",
    "license": "AGPL-3.0-only",
    "homepage": "https://github.com/liberuum/knowledge-vault-app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/kv-node"
    ],
    "resources": {
      "../.stage/sidecar/": "sidecar/"
    },
    "linux": {
      "appimage": {
        "files": {
          "/usr/share/metainfo/io.github.liberuum.knowledge-vault-app.metainfo.xml": "linux/io.github.liberuum.knowledge-vault-app.metainfo.xml"
        }
      },
      "deb": {
        "depends": [],
        "files": {
          "/usr/share/metainfo/io.github.liberuum.knowledge-vault-app.metainfo.xml": "linux/io.github.liberuum.knowledge-vault-app.metainfo.xml"
        }
      }
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "13.5",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
