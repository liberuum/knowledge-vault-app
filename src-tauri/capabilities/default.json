{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://**"
        },
        {
          "url": "http://**"
        },
        {
          "url": "mailto:*"
        }
      ]
    },
    "allow-sidecar-info",
    "allow-open-logs",
    "allow-reveal-path",
    "allow-quit-app",
    "allow-install-update",
    "allow-retry-engine",
    "allow-move-to-applications",
    "allow-open-from-here",
    "allow-host-loaded",
    "allow-take-dropped-paths",
    "allow-choose-backup-destination",
    "allow-choose-backup-file",
    "allow-set-busy"
  ]
}
